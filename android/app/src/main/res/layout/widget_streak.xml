<?xml version="1.0" encoding="utf-8"?>
<!--
  The Duolingo shape: everything readable stacked down the left, the mascot
  large on the right and running off the edge.

  The bleed is the whole trick. A mascot scaled to fit inside its box reads as
  an icon; one that is too big for the widget and gets cut off reads as a
  character standing behind the numbers. It is done with a negative end margin
  and the parent's own clipping — no scaling maths, nothing that changes with
  the cell size.

  Sizing the bleed is less obvious than it looks, because the margin is spent
  on the art's transparent padding before it reaches the animal. The first
  attempt (118dp box, -26dp margin) against art that was 21% padding a side
  cropped nothing at all — the mascot simply sat flush to the edge. With the
  generated art, trimmed to a 4% margin, a box of W and a margin of M cut
  `M - 0.04W` off a head that is 0.92W wide: 170dp and -48dp take about a
  quarter. Re-derive both numbers if the art's padding ever changes.

  The box is also deliberately taller than a 4x2 cell. On a short cell it
  overflows top and bottom and gets clipped, which is the look; on a tall one
  it fills space that otherwise reads as an unfinished card.

  RemoteViews will only inflate a handful of view types, which is why the day
  strip is five hand-written columns rather than anything generated.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_neutral">

    <!-- Drawn first so the text sits over it where the two overlap. Kept
         vertically centred and clear of the rounded corners: below Android 12
         the background shape does not clip its children, so art reaching a
         corner would square off over the rounding. -->
    <ImageView
        android:id="@+id/widget_mascot"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="-48dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_flame"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/widget_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_on_dark"
                android:textSize="30sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/widget_on_dark_muted"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <!--
          The day strip, as two aligned rows rather than five columns: the
          labels need to sit above the marks, but the marks need to be able to
          *join up*. Two consecutive met days are drawn as one capsule the way
          Duolingo does it, which is what makes a run read as a streak instead
          of five separate ticks — and that join is a 9dp block filling the gap
          between two circles, so it has to live in the same row as them.

          Label widths match the mark widths (20dp) and both use the same 9dp
          gap, so the two rows line up without any measuring.
        -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="13dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/widget_day0_label"
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                android:layout_marginEnd="9dp"
                    android:textColor="@color/widget_on_dark_faint"
                    android:textSize="11sp"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/widget_day1_label"
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                android:layout_marginEnd="9dp"
                    android:textColor="@color/widget_on_dark_faint"
                    android:textSize="11sp"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/widget_day2_label"
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                android:layout_marginEnd="9dp"
                    android:textColor="@color/widget_on_dark_faint"
                    android:textSize="11sp"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/widget_day3_label"
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                android:layout_marginEnd="9dp"
                    android:textColor="@color/widget_on_dark_faint"
                    android:textSize="11sp"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/widget_day4_label"
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:textColor="@color/widget_on_dark_faint"
                    android:textSize="11sp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">
                <ImageView
                    android:id="@+id/widget_day0_dot"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/widget_day0_link"
                    android:layout_width="9dp"
                    android:layout_height="15dp"
                    android:background="@color/widget_day_met"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/widget_day1_dot"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/widget_day1_link"
                    android:layout_width="9dp"
                    android:layout_height="15dp"
                    android:background="@color/widget_day_met"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/widget_day2_dot"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/widget_day2_link"
                    android:layout_width="9dp"
                    android:layout_height="15dp"
                    android:background="@color/widget_day_met"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/widget_day3_dot"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/widget_day3_link"
                    android:layout_width="9dp"
                    android:layout_height="15dp"
                    android:background="@color/widget_day_met"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/widget_day4_dot"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
