<?xml version="1.0" encoding="utf-8"?>
<!-- Card background for the "sad" mood — late, and the streak is on the line. Resolved by name in
     WidgetState.

     Left to right, dark to bright, after Duolingo's: the text lives on the
     left, so that end carries the contrast, and the bright end is behind the
     mascot where nothing has to be read. The middle stop sits halfway
     across but holds a colour only 30% of the way to the bright end, so the
     first half of the card — all of the text — stays within reach of white at
     4.5:1 while the far end still lifts. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:startColor="#5F222C"
        android:centerColor="#7D303D"
        android:endColor="#C35164"
        android:angle="0" />
    <corners android:radius="@dimen/widget_corner_radius" />
</shape>
