<?xml version="1.0" encoding="utf-8"?>
<!-- A day a streak freeze covered.
     Deliberately a different *shape*, not just a different colour: colour
     alone would separate these two only for people who can see the
     difference, and the distinction matters — the streak survived the day,
     but nobody studied. The round part shares its centre with
     widget_day_done so the two line up in a row. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp" android:height="20dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <path android:pathData="M6.6,16.6 L12,23.4 L17.4,16.6 Z" android:fillColor="@color/widget_frozen" />
    <path android:pathData="M12,3 a9,9 0 1,0 0,18 a9,9 0 1,0 0,-18 Z"
        android:fillColor="@color/widget_frozen" />
    <path android:pathData="M8,12.2 L10.8,15 L16,9.6" android:strokeColor="#FFFFFF"
        android:strokeWidth="2.3" android:strokeLineCap="round" android:strokeLineJoin="round" />
</vector>
