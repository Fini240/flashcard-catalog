     missed day: today is still open, and the strip should say where "now" is
     at a glance. The ring sits inside the 28dp box so it lines up with the
     filled marks either side of it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="28dp" android:height="28dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <path android:pathData="M12,1 a11,11 0 1,0 0,22 a11,11 0 1,0 0,-22 Z"
        android:fillColor="#24FFFFFF"
        android:strokeColor="#EBFFFFFF"
        android:strokeWidth="2" />
</vector>
