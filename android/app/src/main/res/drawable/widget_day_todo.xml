<?xml version="1.0" encoding="utf-8"?>
<!-- A day that was missed, or today before it is finished. A well punched into
     the card rather than a lighter disc on top of it: darker than its
     background is the one thing that stays legible on all six mood colours,
     and it reads as "nothing here yet" instead of as a second kind of tick. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="26dp" android:height="26dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <path android:pathData="M12,0 a12,12 0 1,0 0,24 a12,12 0 1,0 0,-24 Z"
        android:fillColor="@color/widget_day_todo" />
</vector>
