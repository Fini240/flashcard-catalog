# Copy this file to android/keystore.properties and fill in your own values.
# That file is gitignored — it must never be committed or shared.
#
# Generate the keystore first (see PLAY_STORE.md), then point storeFile at it.
# storeFile is resolved relative to the android/ directory.
storeFile=upload-keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
