rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The user's own catalog — subjects, progress, and (on older accounts)
    // the pre-migration cards array. Strictly private.
    //
    // Update carries one extra condition, and it is here rather than only in
    // the client because the client has now got this wrong twice in one day:
    // a device holding an empty catalog — because it had never read the
    // account, or because an earlier bug emptied it — wrote that emptiness
    // over a real subject tree, twice, with a timestamp that made it look
    // like the freshest word on the subject. Losing 3000 XP and every folder
    // to a client-side race is not something a security rule should permit.
    //
    // So: a write may not take a non-empty subjects array (or cards array) to
    // an empty one unless it says out loud that a person meant it, by setting
    // clearedOnPurpose to this write's own updatedAt. Tying the flag to the
    // timestamp is what stops it from being a switch that, once flipped,
    // stays on: it authorises exactly one write and nothing after it.
    //
    // Everything else — creating the document, reading it, writes that keep
    // or grow the catalog — is unchanged.
    // `delete` is deliberately absent. It was the guard's blind spot: the update
    // rule below refuses to let a catalog go empty without a deliberate flag,
    // and an unconditional delete walked straight around it — remove the
    // document, recreate it empty, and the protection never fires. No client
    // path deletes this document, so withholding it costs nothing. (A delete
    // also would not remove the `cards` subcollection, leaving it orphaned.)
    // Account deletion, if it is ever added, belongs in a Cloud Function that
    // can clear the subcollection too.
    match /users/{userId} {
      allow read, create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
                    && (
                      (
                        (request.resource.data.get('subjects', []).size() > 0
                         || resource.data.get('subjects', []).size() == 0)
                        &&
                        (request.resource.data.get('cards', []).size() > 0
                         || resource.data.get('cards', []).size() == 0)
                      )
                      || request.resource.data.get('clearedOnPurpose', 0)
                         == request.resource.data.get('updatedAt', -1)
                    );
    }

    // The cards subcollection (users/{uid}/cards/{cardId}). Rules do not
    // cascade, so without this every per-card write is PERMISSION_DENIED.
    // Deliberately NOT a {document=**} wildcard on /users/{userId}: that form
    // also matches the parent document, and since rules are OR'd it would
    // hand back exactly the unconditional write access the block above exists
    // to withhold.
    match /users/{userId}/cards/{cardId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Username reservations. The document id is the lowercased name, so
    // uniqueness is the database's job rather than the client's.
    //
    // `create` only ever fires on a document that does not exist, which makes
    // this the whole concurrency story: two clients racing for the same name
    // produce one winner and one PERMISSION_DENIED, with no transaction.
    // Rewriting a reservation you already hold is allowed so re-claiming your
    // own name isn't reported as "taken"; taking one someone else holds is not.
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid
                    && name.size() >= 3 && name.size() <= 16
                    && name.matches('^[a-z0-9_-]+$');
      // hasOnly mirrors `create`. Without it the key set was pinned when the
      // reservation was made and unpinned forever after, so the holder could
      // grow their own reservation into arbitrary storage one update at a time.
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Shared decks. The document id is the six-character code the owner reads
    // out; `create` only ever fires on a document that does not exist, so two
    // people generating the same code produce one winner and one
    // PERMISSION_DENIED rather than one silently overwriting the other's deck.
    // That is the same trick the username reservation uses, and it is what
    // makes the retry loop in deckShare.publish correct.
    //
    // Readable by any signed-in user: a code is meant to be passed around, and
    // guessing one is a 1-in-31^6 (~900 million) proposition. Not world-
    // readable, so a code posted publicly still only reaches people with an
    // account.
    //
    // byUid is pinned to the writer so a deck cannot be published under someone
    // else's name, and only that person can replace or delete it. The card
    // count and the payload size are bounded here as well as in the client:
    // the client bound is a courtesy to the user, this one is the actual limit.
    match /sharedDecks/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.byUid == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                         'name', 'description', 'cards', 'cardCount',
                         'byUsername', 'byUid', 'createdAt', 'version', 'code'
                       ])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.cards is list
                    && request.resource.data.cards.size() > 0
                    && request.resource.data.cards.size() <= 2000
                    && code.size() == 6;
      // Replacing your own deck is allowed — it is how a correction reaches
      // people who have not imported it yet. It cannot change hands.
      allow update: if request.auth != null
                    && resource.data.byUid == request.auth.uid
                    && request.resource.data.byUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.byUid == request.auth.uid;
    }

    // Public competition profile. Deliberately tiny: a self-chosen username, an
    // avatar emoji, a friend code and the scoreboard numbers.
    //
    // There is no `name` key in this list, and that is the point. Every signed
    // in user can read every profile and the global board shows them to
    // strangers, so publishing the Google display name would be publishing
    // people's real names. Pinning the key set means the client cannot send
    // one even by mistake — the write is rejected rather than merged.
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.data.keys().hasOnly([
                        'uid', 'username', 'emoji', 'code', 'xp', 'weekXp', 'weekKey',
                        'streak', 'level', 'rank', 'cardsTotal', 'listed', 'updatedAt'
                      ])
                   && request.resource.data.username is string
                   && request.resource.data.username.size() <= 16
                   && request.resource.data.uid == userId
                   // The scoreboard numbers are still computed on the client, so
                   // these bounds are not a claim that the board is honest —
                   // a determined user can write any value in range. What they
                   // do is bound the damage: the board sorts on weekXp, and an
                   // unbounded one lets a single write pin someone to the top of
                   // it permanently. The ceilings are far above any real play
                   // (weekXp: ~7 days of solid study) so no honest write is
                   // rejected. Making the board trustworthy needs a Cloud
                   // Function that owns these fields; this is the cheap half.
                   && request.resource.data.xp is number
                   && request.resource.data.xp >= 0
                   && request.resource.data.xp <= 100000000
                   && request.resource.data.weekXp is number
                   && request.resource.data.weekXp >= 0
                   && request.resource.data.weekXp <= 1000000
                   && request.resource.data.streak is number
                   && request.resource.data.streak >= 0
                   && request.resource.data.streak <= 20000
                   && request.resource.data.level is number
                   && request.resource.data.level >= 0
                   && request.resource.data.cardsTotal is number
                   && request.resource.data.cardsTotal >= 0;

      // "I added you" markers, which is how a friendship becomes mutual: a
      // friend list lives in a private document nobody else can write, so the
      // adder leaves this instead and the owner folds it into their own list.
      //
      // The document id must be the sender's own uid. That makes it idempotent
      // and caps the damage: one person can leave exactly one marker, so this
      // can't be used to flood someone's inbox or as free storage.
      match /friendAdds/{friendId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
                              && friendId == request.auth.uid
                              && request.resource.data.keys().hasOnly(['from', 'at'])
                              && request.resource.data.from == request.auth.uid;
      }

      // Nudges are the one thing a friend may write into your space: a tap
      // that says "your streak is at risk".
      //
      // The document id must be the sender's own uid, for the same reason as
      // friendAdds above — and this rule previously left it free, which made
      // the "can't be used as storage" claim false: with auto-ids one script
      // could create unlimited documents, each carrying an unbounded `name`
      // string, in any profile it could read (which is all of them). Pinning
      // the id makes a nudge idempotent — one sender, one document, overwritten
      // rather than piled up — and the size bounds cap what a single one costs.
      //
      // A resend has to be an update once the id is fixed, so `update` is
      // allowed too; it is the same write with the same constraints.
      match /nudges/{nudgeId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
                      && nudgeId == request.auth.uid
                      && request.resource.data.from == request.auth.uid
                      && request.resource.data.keys().hasOnly(['from', 'name', 'emoji', 'at'])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() <= 32
                      && request.resource.data.emoji is string
                      && request.resource.data.emoji.size() <= 8;
      }
    }
  }
}
