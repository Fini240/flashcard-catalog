rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The user's own catalog — cards, subjects, progress. Strictly private.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public competition profile. Deliberately tiny: a display name, an
    // avatar emoji, a friend code and the scoreboard numbers. No card content
    // and no email ever lands here, so making it readable to signed-in users
    // exposes nothing the user didn't opt into by adding a friend.
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.data.keys().hasOnly([
                        'uid', 'name', 'emoji', 'code', 'xp', 'weekXp', 'weekKey',
                        'streak', 'level', 'rank', 'cardsTotal', 'updatedAt'
                      ]);

      // Nudges are the one thing a friend may write into your space: a tap
      // that says "your streak is at risk". Create-only, and only for
      // yourself as the sender, so it can't be forged or used as storage.
      match /nudges/{nudgeId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.resource.data.from == request.auth.uid
                      && request.resource.data.keys().hasOnly(['from', 'name', 'emoji', 'at']);
      }
    }
  }
}
